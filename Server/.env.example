PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/risetogether?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Required for Career Coach, CV Coach and Interview Coach. Keep this server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# CV Coach uses its own inexpensive model but the SAME spending pool and caps.
OPENAI_CV_MODEL=gpt-4.1-mini
# Interview questions and evaluation each reserve ONE request from the same pool.
OPENAI_INTERVIEW_MODEL=gpt-4.1-mini
# Persistent caps shared by Career chat/reports, CV analysis, Interview Coach and all instances.
AI_USER_HOURLY_LIMIT=3
AI_USER_DAILY_LIMIT=5
AI_MAX_REQUESTS=20
AI_BUDGET_USD=3.00
# Conservative cost reservation per attempt; no refunds on failures.
# Review pricing and set this explicitly when changing OPENAI_MODEL.
AI_REQUEST_RESERVE_USD=0.10

# Restricted real-time interview rollout. All gates must be configured; off by default.
# Diagnose safely (no sessions or quota writes): npm run realtime:diagnose
# The regular OPENAI_API_KEY does NOT substitute for OPENAI_REALTIME_API_KEY.
REALTIME_ENABLED=false
REALTIME_ALLOWED_USER_IDS=
# Separate project key. Never put this or OPENAI_API_KEY in a VITE_ variable.
OPENAI_REALTIME_API_KEY=
# Set true ONLY after verifying a provider-enforced hard spending cap on that project.
# A budget notification/alert is NOT a hard cap. Otherwise keep voice disabled.
REALTIME_PROJECT_HARD_CAP_CONFIRMED=false
# Reserve against the SAME persistent AI_BUDGET_USD pool, with no refunds.
# Required, minimum $2.75 for the reviewed capped mini-model demo (see REALTIME_INTERVIEW.md).
# AI_BUDGET_USD must have remaining capacity for this plus $0.10 feedback (two request slots).
REALTIME_SESSION_RESERVE_USD=
# 60–600 seconds; 600 by default. Heartbeat loss ends the call separately.
REALTIME_MAX_SECONDS=600

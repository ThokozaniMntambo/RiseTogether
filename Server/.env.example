PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/risetogether?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Required for AI Career Coach generation. Keep this server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Persistent caps shared by chat, reports and all server instances.
AI_USER_HOURLY_LIMIT=3
AI_USER_DAILY_LIMIT=5
AI_MAX_REQUESTS=20
AI_BUDGET_USD=3.00
# Conservative cost reservation per attempt; no refunds on failures.
# Review pricing and set this explicitly when changing OPENAI_MODEL.
AI_REQUEST_RESERVE_USD=0.10
